{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesvencimos.com/app/module.schema.json",
  "title": "Les vencimos module.json",
  "type": "object",
  "required": [
    "id",
    "nombre",
    "version",
    "entrada"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "nombre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "maxLength": 32
    },
    "publico": {
      "type": "string",
      "enum": [
        "estudios",
        "infantil",
        "midia",
        "casa",
        "varios"
      ]
    },
    "red": {
      "type": "boolean",
      "default": false
    },
    "entrada": {
      "type": "string",
      "description": "HTML relativo dentro del pack"
    },
    "permisos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "red",
          "camara",
          "microfono",
          "geo"
        ]
      }
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
